{
  "manifest_version": 3,
  "name": "ClipForge — Cortes automáticos",
  "description": "Envie vídeos e lives do YouTube para o ClipForge gerar cortes legendados e publicar em sequência.",
  "version": "0.1.0",
  "minimum_chrome_version": "110",
  "action": {
    "default_title": "ClipForge",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["common.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
