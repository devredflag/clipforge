# Copie para ".env" e preencha. Nunca compartilhe este arquivo preenchido.

# Endereço público do backend. Em uso local, deixe como está.
# Para conectar TikTok/YouTube, o redirecionamento do login precisa ser HTTPS e acessível pela internet:
# rode um túnel (ex.: cloudflared ou ngrok) apontando para a porta 8765 e coloque a URL https aqui.
PUBLIC_BASE_URL=http://localhost:8765

# --- YouTube (Google Cloud Console → APIs e Serviços → Credenciais → ID do cliente OAuth, tipo "Aplicativo da Web") ---
# Ative a "YouTube Data API v3" no projeto.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Opcional: se vazio, usa PUBLIC_BASE_URL + /auth/youtube/callback. Cadastre esta URL exata no console.
YOUTUBE_REDIRECT_URI=

# --- TikTok (TikTok for Developers → seu app → Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Opcional: se vazio, usa PUBLIC_BASE_URL + /auth/tiktok/callback. Cadastre esta URL exata (precisa ser HTTPS).
TIKTOK_REDIRECT_URI=

# Onde guardar banco, vídeos e token (padrão: ./data)
# CLIPFORGE_DATA=/caminho/para/data
# Porta e host do servidor (padrão: 127.0.0.1:8765)
# CLIPFORGE_HOST=127.0.0.1
# CLIPFORGE_PORT=8765
